{
  "name": "hakimi-milky",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"shared/**/*.test.mjs\" \"orchestrator/**/*.test.mjs\" \"payments/**/*.test.mjs\" \"registry/**/*.test.mjs\" \"specialists/**/*.test.mjs\" \"ops/**/*.test.mjs\" \"track-record/**/*.test.mjs\" \"evidence/**/*.test.mjs\"",
    "offline": "node --env-file-if-exists=.env orchestrator/run-offline.mjs",
    "live": "node --env-file-if-exists=.env orchestrator/run-live.mjs",
    "batch": "node --env-file-if-exists=.env orchestrator/run-batch.mjs",
    "redteam": "node --env-file-if-exists=.env orchestrator/run-redteam.mjs",
    "probe:c2": "node --env-file-if-exists=.env payments/probe-c2.mjs",
    "payments:key": "node --env-file-if-exists=.env payments/buyer-key.mjs",
    "track-record": "node --env-file-if-exists=.env track-record/track-record.mjs",
    "rejections": "node --env-file-if-exists=.env payments/rejections.mjs",
    "reconcile": "node --env-file-if-exists=.env orchestrator/run-reconcile.mjs",
    "crash-test": "node --env-file-if-exists=.env orchestrator/crash-test.mjs",
    "owner": "node --env-file-if-exists=.env orchestrator/run-owner.mjs",
    "registry:connect-older": "node --env-file-if-exists=.env ops/connect-older-contract.mjs",
    "third-party": "node --env-file-if-exists=.env orchestrator/run-third-party.mjs",
    "refund": "node frontdesk/answer-refund.mjs",
    "registry": "node --env-file-if-exists=.env registry/run-catalog.mjs",
    "registry:allow": "node --env-file-if-exists=.env registry/run-allow.mjs",
    "evidence": "node evidence/evidence-page.mjs",
    "specialists": "node --env-file-if-exists=.env specialists/start.mjs",
    "specialists:register": "node --env-file-if-exists=.env specialists/register.mjs",
    "online": "node ops/keep-online.mjs start",
    "online:status": "node ops/keep-online.mjs status",
    "online:watch": "node ops/keep-online.mjs watch",
    "online:stop": "node ops/keep-online.mjs stop"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.62",
    "@typesafe-ai/sdk": "0.7.0",
    "ai": "7.0.127",
    "async-mutex": "0.5.0",
    "csv-parse": "7.0.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "fast-check": "4.10.2"
  }
}
