# Copy to .env and fill in. .env is git-ignored. Tests need none of these.

# Model for the planner, through an OpenAI-compatible endpoint.
ZAI_API_KEY=
ZAI_BASE_URL=https://api.anthropic.com/v1
ZAI_MODEL=claude-opus-5-5

# Jev decision model for the reviewer.
TYPESAFE_API_KEY=

# Cardano Preprod.
BLOCKFROST_API_KEY_PREPROD=
MPS_URL=http://127.0.0.1:38127

# Specialists and the limited key. ADMIN_KEY is needed by specialists:register, payments:key and rejections; the agents use the narrower key that specialists:register creates.
# key that command creates. SELLING_WALLET_VKEY is only needed with several selling wallets.
ADMIN_KEY=
AGENT_AUTHOR=
SELLING_WALLET_VKEY=
# Makes the cheap agent misbehave for the refund demo: drop_rows:2 or no_show.
FAULT=
