 import { setupTracing } from '@/tracing';
 
+// got 11 can schedule a retry for a Blockfrost request that has already finished. Its timer then throws
+// where no caller can catch it, and the new request it has just started has nobody listening, so if the
+// network is down that one throws too. Either would stop the whole service and its escrow jobs. Nothing
+// waits on these requests, so they are logged and ignored. Any other uncaught error still ends the process.
+const GOT_RETRY_AFTER_SETTLED = 'The `onCancel` handler was attached after the promise settled.';
+const isOrphanedRequestError = (error: Error) => error.message === GOT_RETRY_AFTER_SETTLED || 'timings' in error;
+process.on('uncaughtException', (error) => {
+	if (isOrphanedRequestError(error)) {
+		console.error('Ignored an error from a request nobody is waiting for:', error.message);
+		return;
+	}
+	console.error('Uncaught exception', error);
+	process.exit(1);
+});
+
 export async function bootstrap() {
 	await setupTracing();
 	const { startApp } = await import('@/app');
